# =============================================================
# .env.example — Backend Cabaxx (Bogotá D.C., Colombia)
# =============================================================
# Copia este archivo a `.env` para desarrollo local, o pega
# los valores en la pestaña "Variables" del servicio en Railway.
# =============================================================

NODE_ENV=production
PORT=4000
LOG_LEVEL=info
API_PREFIX=/api/v1

# =============================================================
# DATABASE — MySQL (Railway)
# =============================================================
# OPCIÓN A (RECOMENDADA en Railway): usa la URL completa.
#   DATABASE_URL=mysql://root:PASSWORD@mysql.railway.internal:3306/railway
#
# OPCIÓN B: referencia a las variables del servicio MySQL de Railway
# (sintaxis ${{Servicio.VAR}}). Funciona con Service Reference.
#   DB_HOST="${{MySQL.MYSQLHOST}}"
#   DB_PORT="${{MySQL.MYSQLPORT}}"
#   DB_USER="${{MySQL.MYSQLUSER}}"
#   DB_PASSWORD="${{MySQL.MYSQLPASSWORD}}"
#   DB_NAME="${{MySQL.MYSQLDATABASE}}"
#
# OPCIÓN C: literales (para local con docker-compose o MySQL local).
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=cabaxx_user
#   DB_PASSWORD=cabaxx_pass
#   DB_NAME=cabaxx_platform
# =============================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=cabaxx_user
DB_PASSWORD=
DB_NAME=cabaxx_platform
DB_CONNECTION_LIMIT=10
DB_SSL=false

# URL completa (tiene prioridad sobre DB_*).
# En Railway: pega aquí la URL de tu MySQL, ej:
#   DATABASE_URL=mysql://root:hhjtPlByQwnmceTPJXsMJcpbjdbusIJh@mysql.railway.internal:3306/railway
# DATABASE_URL=

# =============================================================
# JWT — genera con: openssl rand -hex 32
# =============================================================

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cabaxx.com

# =============================================================
# COOKIES
# =============================================================

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# =============================================================
# FRONTEND
# =============================================================
# Dominio del frontend en Netlify (sin slash al final).
# Se usa para CORS, SEO y construcción de URLs absolutas.
# =============================================================

CLIENT_URL=https://cabaxx.netlify.app

# CORS — lista separada por comas de orígenes permitidos.
# En producción, el proxy de Netlify hace que el browser vea
# mismo origen, pero dejamos esto por si llamas al backend
# directamente desde otro dominio (ej. admin tools).
CORS_ORIGIN=https://cabaxx.netlify.app

# =============================================================
# CLOUDINARY (uploads de imágenes / audio)
# =============================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cabaxx

# =============================================================
# LÍMITES DE SUBIDA
# =============================================================

MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav

# =============================================================
# EMAIL (Nodemailer / SMTP)
# =============================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@cabaxx.com

# =============================================================
# RATE LIMIT
# =============================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =============================================================
# PAGOS (stripe | mercadopago)
# =============================================================

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================
# ADMIN SEED (lo usa `node seed.js` en el arranque)
# =============================================================

ADMIN_NAME=Cabaxx Admin
ADMIN_EMAIL=admin@cabaxx.com
ADMIN_PASSWORD=
