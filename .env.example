# .env.example — Backend Cabaxx (Bogotá D.C., Colombia)
# ============================================================
# Copia este archivo a `.env` para desarrollo local.
# En Railway, configura estas variables en el servicio
# "Cabaxx-backend" (pestaña Variables).
# ============================================================

# ── Entorno ───────────────────────────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
API_PREFIX=/api/v1

# ── Base de datos ─────────────────────────────────────────
# En RAILWAY: usa una sola de estas dos opciones y BORRA DB_*
#
#   OPCIÓN A (recomendada): vincula el servicio MySQL al backend
#   → agrega la variable "MYSQL_URL" como Service Reference desde
#     el servicio MySQL, o pega aquí la URL completa:
#   DATABASE_URL=mysql://root:PASSWORD@mysql.railway.internal:3306/railway
#
#   OPCIÓN B: define MYSQLHOST / MYSQLUSER / MYSQLPASSWORD / MYSQLPORT
#   / MYSQLDATABASE manualmente (mira los valores en la pestaña
#   Variables del servicio MySQL de Railway).
#
# En LOCAL: usa los DB_* (o levanta MySQL con docker-compose).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10
DB_SSL=false

# URL completa (tiene prioridad sobre DB_* y sobre MYSQLHOST/USER/...)
# DATABASE_URL=mysql://root:PASSWORD@mysql.railway.internal:3306/railway

# ── JWT — genera con: openssl rand -hex 32 ────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cabaxx.com

# ── Cookies ───────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# ── Frontend (origen) ─────────────────────────────────────
CLIENT_URL=https://cabaxx.netlify.app

# ── Cloudinary (uploads) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cabaxx

# ── Límites de subida ─────────────────────────────────────
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav

# ── Email (Nodemailer / SMTP) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@cabaxx.com

# ── CORS — lista separada por comas de orígenes permitidos ─
CORS_ORIGIN=https://cabaxx.netlify.app

# ── Rate limit ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Pagos (stripe | mercadopago) ──────────────────────────
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Admin inicial (lo usa `node seed.js`) ─────────────────
ADMIN_NAME=Cabaxx Admin
ADMIN_EMAIL=admin@cabaxx.com
ADMIN_PASSWORD=
