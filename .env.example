NODE_ENV="production"
PORT="4000"
LOG_LEVEL="info"
API_PREFIX="/api/v1"

# ==========================================
# DATABASE - MYSQL / RAILWAY
# ==========================================

DB_HOST="${{MySQL.MYSQLHOST}}"
DB_PORT="${{MySQL.MYSQLPORT}}"
DB_USER="${{MySQL.MYSQLUSER}}"
DB_PASSWORD="${{MySQL.MYSQLPASSWORD}}"
DB_NAME="${{MySQL.MYSQLDATABASE}}"
DB_CONNECTION_LIMIT="10"
DB_SSL="false"

# ==========================================
# JWT / AUTHENTICATION
# ==========================================

JWT_ACCESS_SECRET="REEMPLAZAR_CON_SECRET_ALEATORIO_LARGO"
JWT_REFRESH_SECRET="REEMPLAZAR_CON_OTRO_SECRET_ALEATORIO_LARGO"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="cabaxx.com"

# ==========================================
# COOKIES
# ==========================================

COOKIE_SECURE="true"
COOKIE_SAME_SITE="lax"

# ==========================================
# FRONTEND
# ==========================================

CLIENT_URL="https://cabaxx.netlify.app"
CORS_ORIGIN="https://cabaxx.netlify.app"

# ==========================================
# CLOUDINARY
# ==========================================

CLOUDINARY_CLOUD_NAME="REEMPLAZAR"
CLOUDINARY_API_KEY="REEMPLAZAR"
CLOUDINARY_API_SECRET="REEMPLAZAR"
CLOUDINARY_FOLDER="cabaxx"

# ==========================================
# FILE UPLOADS
# ==========================================

MAX_FILE_SIZE="10485760"
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
ALLOWED_AUDIO_TYPES="audio/mpeg,audio/wav"

# ==========================================
# SMTP / EMAIL
# ==========================================

SMTP_HOST="REEMPLAZAR"
SMTP_PORT="587"
SMTP_USER="REEMPLAZAR"
SMTP_PASS="REEMPLAZAR"
MAIL_FROM="no-reply@cabaxx.com"

# ==========================================
# RATE LIMIT
# ==========================================

RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# ==========================================
# PAYMENTS
# ==========================================

PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="REEMPLAZAR"
STRIPE_WEBHOOK_SECRET="REEMPLAZAR"

# ==========================================
# ADMIN
# ==========================================

ADMIN_NAME="Cabaxx Admin"
ADMIN_EMAIL="admin@cabaxx.com"
ADMIN_PASSWORD="REEMPLAZAR"