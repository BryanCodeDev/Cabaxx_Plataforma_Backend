# .env.example — Backend Cabaxx (Bogotá D.C., Colombia)
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
API_PREFIX=/api/v1

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cabaxx_user
DB_PASSWORD=
DB_NAME=cabaxx_platform
DB_CONNECTION_LIMIT=10

# JWT — generate strong secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cabaxx.com

# Cookies
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Client (frontend origin)
CLIENT_URL=https://cabaxx.netlify.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cabaxx

# Uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav

# Email (Nodemailer / SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@cabaxx.com

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=https://cabaxx.netlify.app

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Payment provider (stripe | mercadopago)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
